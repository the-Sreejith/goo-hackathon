[Unit]
Description=DummE llama.cpp server (Gemma 3n E2B)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dumme
Group=dumme
WorkingDirectory=/home/dumme/dumme
ExecStart=/home/dumme/llama.cpp/build/bin/llama-server \
    -m /home/dumme/dumme/models/gemma-3n-E2B-it-Q4_K_M.gguf \
    --ctx-size 2048 \
    --threads 4 \
    --host 127.0.0.1 \
    --port 8080
Restart=on-failure
RestartSec=5
# Pi 5 has 4GB RAM. OOM-kill this instead of anything else.
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
