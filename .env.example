# Copy to .env and adjust per deployment.
# .env is gitignored; .env.example is safe to commit.

# URL of the running llama.cpp HTTP server (Gemma backend)
LLAMA_URL=http://127.0.0.1:8080

# FastAPI bind
APP_HOST=0.0.0.0
APP_PORT=8000

# Logging
LOG_LEVEL=INFO

# Path overrides (optional — defaults resolve relative to repo root)
# DUMME_CONFIG_DIR=/home/dumme/goo-hackathon/config
# DUMME_STATIC_DIR=/home/dumme/goo-hackathon/static

# Safety
ESTOP_ON_START=false
